# ============================================================
# Multi-Cluster Kubernetes Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- AWS Configuration ---
AWS_REGION_PRIMARY=us-east-1
AWS_REGION_SECONDARY=eu-west-1
AWS_ACCOUNT_ID=123456789012

# --- Cluster Names ---
MANAGEMENT_CLUSTER_NAME=management-cluster
STAGING_CLUSTER_NAME=staging-cluster
PRODUCTION_CLUSTER_NAME=production-cluster

# --- ArgoCD ---
ARGOCD_URL=https://argocd.example.com
ARGOCD_TOKEN=your-argocd-token-here

# --- GitHub Integration ---
GITHUB_TOKEN=ghp_your_github_token_here
AUTH_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
AUTH_GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# --- Backstage ---
BACKSTAGE_BASE_URL=http://localhost:3000
BACKSTAGE_BACKEND_URL=http://localhost:7007
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=change-me-in-production

# --- Cluster API Endpoints (populated by terraform output) ---
MANAGEMENT_CLUSTER_URL=https://management-cluster.example.com
STAGING_CLUSTER_URL=https://staging-cluster.example.com
PRODUCTION_CLUSTER_URL=https://production-cluster.example.com

# --- Kubernetes Service Account Tokens for Backstage ---
MANAGEMENT_SA_TOKEN=your-management-sa-token
STAGING_SA_TOKEN=your-staging-sa-token
PRODUCTION_SA_TOKEN=your-production-sa-token

# --- Istio ---
EXTERNAL_ISTIOD_ADDR=istio-eastwestgateway.istio-system.svc.cluster.local

# --- Observability ---
THANOS_S3_BUCKET=multi-cluster-thanos-metrics
LOKI_S3_BUCKET=multi-cluster-loki-logs
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# --- Docker Registry ---
DOCKER_REGISTRY=ghcr.io/Dakshayani2005
